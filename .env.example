# Data source: "mock" (default, no setup needed) or "sheets"
DATA_SOURCE=mock

# --- Google Sheets (required only when DATA_SOURCE=sheets) ---
# Read-only service account with access to the existing SMS -> Sheets
# spreadsheet. Never commit real values here — this file is an example only.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Sheet/tab + range containing transaction rows (A1 notation).
# NOTE: confirm the real tab name and column headers against the existing
# SMS -> Sheets pipeline before relying on this — see src/lib/sheets/mapRow.ts.
GOOGLE_SHEETS_TRANSACTIONS_RANGE=Transactions!A:T
