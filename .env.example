# --- App access (optional) ---
# Leave both unset for zero-config local dev (no login gate). Set both to
# require a password before anyone can view the app.
APP_ACCESS_PASSWORD=
# Random secret used to sign session cookies — generate with e.g.
# `openssl rand -base64 32`. Required if APP_ACCESS_PASSWORD is set.
SESSION_SECRET=

# Data source: "mock" (default, no setup needed) or "sheets"
DATA_SOURCE=mock

# --- Google Sheets (required only when DATA_SOURCE=sheets) ---
# Read-only service account with access to the existing SMS -> Sheets
# spreadsheet. Never commit real values here — this file is an example only.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Sheet/tab + range containing transaction rows (A1 notation).
# The confirmed real sheet has NO header row and 4 columns in this order:
# datetime ("M/D/YYYY H:mm:ss"), payee, amount, note/tag — see
# src/lib/sheets/mapRow.ts. "A:D" targets the first tab.
GOOGLE_SHEETS_TRANSACTIONS_RANGE=A:D

# --- Gmail historical importer (required only when GMAIL_SOURCE=live) ---
# Gmail has no service-account option for a personal inbox — obtain a
# refresh token once via Google's OAuth consent screen (OAuth client of type
# "Desktop app" or "Web application", scope
# https://www.googleapis.com/auth/gmail.readonly), then paste it here.
GMAIL_SOURCE=mock
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Dedicated tab (owned by this app, never the existing SMS tab) that Gmail
# IMPORT writes to. Requires the Sheets service account above to have edit
# access, not just read access.
GOOGLE_SHEETS_GMAIL_IMPORT_RANGE=GmailImports!A:T

# --- Finance AI (optional) ---
# "template" (default) needs no setup — deterministic, cannot hallucinate.
# "openai" | "gemini" | "cloudflare" call a real LLM, grounded only in the
# structured metrics from src/lib/ai/context.ts (never raw transaction data).
AI_PROVIDER=template
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# cloudflare: not wired yet — no Next.js 16-compatible Cloudflare adapter
# exists as of this writing (see src/lib/ai/providers/cloudflare-provider.ts).
