{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finance-tracker",
  "main": "./custom-worker.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Ongoing incremental Gmail scan — see src/lib/gmail/scheduledScan.ts and
  // custom-worker.ts. Runs hourly; capped small per run so it always finishes
  // well within Workers execution limits (catches up incrementally rather
  // than needing to process everything in one run).
  "triggers": {
    "crons": ["0 * * * *"]
  },
  // Persists which Gmail message IDs have been scanned/claimed/imported,
  // across requests, isolates, restarts, and deployments
  // (src/lib/gmail/scanState.ts). D1 (not KV) is used specifically because
  // it gives an atomic claim primitive that prevents two concurrent requests
  // from both importing the same message — see the review that led to this
  // choice. Create the real database with `wrangler d1 create
  // finance-tracker-gmail-scan-state`, apply the schema in
  // src/lib/gmail/scanState.sql, and replace "database_id" below before
  // deploying — without a real id, the Gmail importer will fail loudly
  // rather than silently falling back to per-isolate memory (see
  // resolveD1Binding in scanState.ts).
  "d1_databases": [
    {
      "binding": "GMAIL_SCAN_STATE_DB",
      "database_name": "finance-tracker-gmail-scan-state",
      "database_id": "99207ca2-d612-46d2-aa42-98ea65e261af"
    }
  ]
}
